import io


def sub(p, a, b):
    s = io.open(p, encoding='utf-8').read()
    assert a in s, p
    io.open(p, 'w', encoding='utf-8').write(s.replace(a, b, 1))


D = 'plugins/blog/diagrams.ts'
C = 'src/components/blog/prose.css'

sub(D, ' * Sanitise, namespace, publish as files, and wrap in <picture>.',
    ' * Sanitise, namespace, publish as files, and emit the figure.')

